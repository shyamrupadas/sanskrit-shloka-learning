{
  "name": "@sanskrit-shloka-learning/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:production": "node dist/database/migrate.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "node --import ./node_modules/tsx/dist/esm/index.mjs --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@sanskrit-shloka-learning/api-contract": "workspace:*",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13"
  }
}
